# Copiar a .env.local y completar. NUNCA subir .env.local.

# Supabase -> Project Settings -> API (o "Connect")
NEXT_PUBLIC_SUPABASE_URL=
# Clave pública (anon / publishable). RLS protege los datos.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave secreta (service_role / secret). SOLO servidor, salta RLS.
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000
